{
  "compilerOptions": {
    "module": "ES2020",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["astro/client"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@icon/*": ["src/icon/*"],
      "@utils/*": ["src/utils/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*", "astro.config.ts"]
}
