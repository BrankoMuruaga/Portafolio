---
import { CONTACT_INFO } from "@/utils/data";
const { title, subtitle, message, locationLabel, location } = CONTACT_INFO;
---

<h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{title}</h2>
<h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
  {subtitle}
</h3>
<div class="text-[var(--white-icon)]">
  <p class="mb-4">{message}</p>
  <div class="flex items-center gap-2">
    <span>{locationLabel}</span>
    <span class="text-[var(--white)]">{location}</span>
  </div>
</div>
