---
import { SOCIALS, TECH_STACKS } from "@/utils/data";
import SocialLinks from "./SocialLinks.astro";
import TechStack from "./TechStack.astro";
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-10">
      <div class="flex flex-col lg:items-start items-center space-y-6 gap-9">
        <SocialLinks links={SOCIALS} />
      </div>

      <div class="flex flex-col items-center space-y-6">
        <TechStack stack={TECH_STACKS} />
      </div>

      <div class="flex flex-col items-center justify-center space-y-2">
        <span class="text-[var(--white-icon)] text-sm"
          >© {new Date().getFullYear()} Branko Muruaga. Todos los derechos reservados.</span
        >
      </div>
    </div>
  </div>
</footer>
