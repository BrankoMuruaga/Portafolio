---
import { HOME_INFO } from "@/utils/data";
import LogoWall from "../components/logoWall.astro";
import LetterGlitch from "../React/LetterGlitch.tsx";
import SocialLinks from "./SocialLinks.astro";
import HomeHeader from "./HomeHeader.astro";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-left space-y-4 w-full relative py-10 -translate-y-12">
      <div
        class="absolute top-0 left-0 w-screen h-full z-[-4] pointer-events-none opacity-20 -translate-x-9 md:-translate-x-48 lg:-translate-x-20"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={83}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
      <HomeHeader />
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <SocialLinks links={HOME_INFO.socials} />
      </div>
    </div>

    <LogoWall />
  </div>

  <style is:global>
    .shiny-sec {
      background: linear-gradient(
        135deg,
        #a476ff 25%,
        #eee5ff 50%,
        #a476ff 75%
      );
      background-size: 400% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shine 3s linear infinite;
    }

    @keyframes shine {
      0% {
        background-position: 100% 50%;
      }
      30%,
      70% {
        background-position: 0% 50%;
      }
    }
  </style>
</section>
