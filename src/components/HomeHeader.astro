---
import { HOME_INFO } from "@/utils/data";
const { name, subtitle, description } = HOME_INFO;
---

<p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
  Hola, soy <span class="text-[var(--sec)] shiny-sec">{name}</span>
</p>
<div
  class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
>
  <h1
    class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none"
  >
    {subtitle}
  </h1>
  <p class="text-md md:text-2xl text-[var(--white-icon)] text-pretty">
    <span set:html={description} />
  </p>
</div>
